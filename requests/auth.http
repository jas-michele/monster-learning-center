@host = http://localhost:5001

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
    "firstName": "Jasmine",
    "lastName": "Michele",
    "email": "jasmine@example.com",
    "password": "Password123!"
}

###

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
    "email": "jasmine@example.com",
    "password": "Password123!"
}

